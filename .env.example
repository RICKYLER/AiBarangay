# Copy to .env and fill in real values. NEVER commit the real .env —
# the same vars go into Vercel Project → Settings → Environment Variables.

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="AI Barangay Problem Mapper <your-email@gmail.com>"

# ---- Origins ----
# Local dev: the Next server on :3000 serves BOTH the site and the API
# (pages/api bridge) — but the API origin vars are still read for links.
APP_ORIGIN=http://localhost:3000
BACKEND_ORIGIN=http://localhost:3000
# On Vercel these are optional: env.js derives them from
# VERCEL_PROJECT_PRODUCTION_URL when unset.

# ---- Supabase ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Database (session pooler, IPv4-friendly):
DATABASE_URL=postgresql://<role>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Installer/maintenance only (postgres role, BYPASSRLS — never used by the API):
ADMIN_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
APP_DB_USER=app_user
APP_DB_PASSWORD=app-user-password
BI_DB_PASSWORD=bi-reader-password

# ---- Uploads ----
# Vercel caps request bodies at ~4.5MB; the browser compresses photos first.
MAX_UPLOAD_MB=4

# ---- AI triage model (OpenAI-compatible endpoint) ----
AI_API_KEY=sk-your-key
AI_BASE_URL=https://agentrouter.org/v1
AI_MODEL=glm-5.3
