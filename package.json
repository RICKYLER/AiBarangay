{
  "name": "ai-barangay-problem-mapper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI Barangay Problem Mapper — Tagum City. Next.js frontend + Express API + PostgreSQL/PostGIS (Supabase).",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --prefix backend",
    "dev:web": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "concurrently -n api,web -c blue,green \"npm:start:api\" \"npm:start:web\"",
    "start:api": "npm start --prefix backend",
    "start:web": "npm start --prefix frontend",
    "db:apply": "./database/apply.sh",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^10.0.1"
  }
}
